{
  "name": "@openpet/shared",
  "version": "0.0.0",
  "private": true,
  "description": "OpenPet shared contracts and browser-safe runtime helpers",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./src/*": "./src/*",
    "./browser/*": "./src/*",
    "./runtime/*": "./src/*.cjs"
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
